# ==============================================================================
# MEHREGAN ACCOUNTING & ERP — STAGE 1: FOUNDATION ENVIRONMENT VARIABLES
# ==============================================================================

# Port for the central backend API server (defaults to 3000)
PORT=3000

# GEMINI_API_KEY: Injected by AI Studio if AI capabilities are configured
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current application URL
APP_URL="MY_APP_URL"

# MEHREGAN_DB_URL: Optional PostgreSQL connection URI (e.g. postgresql://admin:password@127.0.0.1:5432/mehregan_db)
# If omitted or offline, the system safely falls back to local persistent relational vault
MEHREGAN_DB_URL="postgresql://postgres:password@127.0.0.1:5432/mehregan_erp"

# MEHREGAN_VAULT_SECRET: Secret key used to encrypt connection credentials on disk using AES-256-GCM
MEHREGAN_VAULT_SECRET="mehregan-local-hardware-bound-vault-secret-2026"

# Initial admin credentials for first launch (Internal DB authentication, no Google/Email required)
# Default username: admin
# Default password: admin (can be changed immediately via User Profile or Security Console)
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="admin"
